import java.util.Stack;

public class Main {
    public static void main(String[] args) {

        Stack<String> words = new Stack<>();

        words.push("Apple");
        words.push("Banana");
        words.push("Orange");
        words.push("Grape");
        words.push("Mango");

        for (int i = 0; i < words.size(); i++) {
            System.out.println(words.get(i));
        }
    }
}
